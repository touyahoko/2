<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【お守り設定】"
            android:textColor="@color/accent_color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="現在持っている護石の情報を入力してください。\n設定しておくと、その護石で発動するスキルを検索できます。"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:paddingBottom="12dp"/>

        <!-- レアリティ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="レアリティ:" android:textColor="@color/label_color" android:textSize="13sp" android:gravity="center_vertical" android:layout_gravity="center_vertical"/>
            <Spinner android:id="@+id/spinnerCharmRarity" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@color/input_bg" android:popupBackground="@color/panel_bg"/>
        </LinearLayout>

        <!-- スキル系統1 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="スキル系統①" android:textColor="@color/label_color" android:textSize="13sp" android:paddingBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Spinner android:id="@+id/spinnerCharmFamily1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="3" android:background="@color/input_bg" android:popupBackground="@color/panel_bg" android:layout_marginEnd="4dp"/>
            <Spinner android:id="@+id/spinnerCharmPoints1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@color/input_bg" android:popupBackground="@color/panel_bg"/>
        </LinearLayout>

        <!-- スキル系統2 -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="スキル系統②（省略可）" android:textColor="@color/label_color" android:textSize="13sp" android:paddingBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Spinner android:id="@+id/spinnerCharmFamily2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="3" android:background="@color/input_bg" android:popupBackground="@color/panel_bg" android:layout_marginEnd="4dp"/>
            <Spinner android:id="@+id/spinnerCharmPoints2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@color/input_bg" android:popupBackground="@color/panel_bg"/>
        </LinearLayout>

        <!-- スロット数 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="スロット数:" android:textColor="@color/label_color" android:textSize="13sp" android:gravity="center_vertical" android:layout_gravity="center_vertical"/>
            <Spinner android:id="@+id/spinnerCharmSlots" android:layout_width="80dp" android:layout_height="40dp" android:background="@color/input_bg" android:popupBackground="@color/panel_bg"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnSaveCharm" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="保存" android:textColor="@color/white" android:backgroundTint="@color/btn_search" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnClearCharm" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="クリア" android:textColor="@color/white" android:backgroundTint="@color/btn_clear"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
