<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 要求護石スキル -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="護石"
            android:textColor="@color/charm_color"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCharmSkills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/charm_color"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCharmSlots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slot_color"
            android:textSize="11sp"
            android:paddingStart="4dp"/>
    </LinearLayout>

    <!-- 装飾品追加要件（護石スロット用） -->
    <TextView
        android:id="@+id/tvDecoReq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/deco_color"
        android:textSize="10sp"
        android:paddingStart="40dp"
        android:visibility="gone"/>

    <!-- 防具5部位 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="頭"
            android:textColor="@color/label_color"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvHead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="胴"
            android:textColor="@color/label_color"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="腕"
            android:textColor="@color/label_color"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvArm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="腰"
            android:textColor="@color/label_color"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvWst"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="脚"
            android:textColor="@color/label_color"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/tvLeg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- 確率（MH4G換算 / 古参換算） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/tvProbMH4G"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/prob_color"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/tvProbOld"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/prob_old_color"
            android:textSize="10sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginTop="4dp"/>

</LinearLayout>
