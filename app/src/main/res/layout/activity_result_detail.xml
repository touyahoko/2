<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_color"
        app:titleTextColor="@color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvHeadDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvBodyDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvArmDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvWstDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvLegDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCharmDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/charm_color"
                android:textSize="14sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDecosDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/deco_color"
                android:textSize="12sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDefenseDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="6dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvProbabilityDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/prob_color"
                android:textSize="12sp"
                android:padding="6dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvActiveSkillsDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/skill_color"
                android:textSize="13sp"
                android:padding="6dp"
                android:background="@color/panel_bg"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveToMySet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="マイセットに保存"
        android:textColor="@color/white"
        android:backgroundTint="@color/btn_search"
        android:layout_margin="8dp"/>

</LinearLayout>
